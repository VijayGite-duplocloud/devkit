# Copy to .env. Normally you DON'T edit most of this by hand — `./run.sh` prompts for the
# email/password/LLM provider on first run and fills the rest in. The image tags and license server
# URL (below) ship with sensible defaults; `./run.sh` keeps them in sync with these defaults on every
# run (so a dev-kit upgrade is picked up automatically). A value you pin — via
# --studio-tag/--ui-tag/--agent-tag or by hand-editing .env — is preserved. See README.

# ─────────────────────────────────────────────────────────────────────────────
# Image tags — pin the published images to run.
#   • UI    : the duplo-ui git SHA (e.g. 02ae64f593513d17a7713fdaeead7b74956085a4)
#   • Studio: deploy_tag = branch-<sanitized-branch>-<short-sha>  (e.g. branch-feature-plugin-acc46696)
#   • Agent : a main tag (no extension-specific changes)
# ─────────────────────────────────────────────────────────────────────────────

STUDIO_TAG=dev-1.0.6-45708c38
AGENT_TAG=dev-0.1.2-4b7fcf1
UI_TAG=f2c422811afb38425b098261312d8e9371469ead
XTERM_TAG=dev-0.1.2-6cdf181

# Qdrant vector database (Knowledge Base). The API key is fixed and not a secret — Qdrant is bound to
# the compose network and localhost only. Change it if you like; compose and scripts/register-qdrant.sh
# both read this one value.
QDRANT_PORT=6333
QDRANT_API_KEY=devkit-local-qdrant

# Extension build toolchain (.NET SDK 8 + Node 22). Only pulled the first time you build an
# extension — the platform itself doesn't use it. An already-pulled tag is reused without checking the
# registry: BUILDER_PULL=1 forces a re-pull (this tag moves), BUILDER_IMAGE=<ref> replaces the image
# outright, BUILDER_PLATFORM=<os/arch> forces an architecture. Each build's package caches live in
# per-uid named volumes that nothing prunes — `docker volume ls | grep duplo_devkit` to find and
# `docker volume rm` to reclaim them (each holds a full NuGet + npm closure).
BUILDER_TAG=latest

# Build on THIS machine instead of in the toolchain container. Set to 1 if you already have .NET SDK 8
# and Node 22+ installed and would rather use them — you own keeping them current, and your builds stop
# matching what CI and the agent produce. Accepts 1/true/yes/on (or 0/false/no/off to be explicit);
# anything else is rejected rather than quietly assumed false. `--native` on either build script does the
# same thing for a single run, and wins over this. Leave it commented out to build in the container.
#DUPLO_BUILD_NATIVE=1

# On Apple Silicon the studio image is amd64-only (emulated). Leave as-is unless you have an arm64 image.
STUDIO_PLATFORM=linux/amd64

# ── Host ports ──
# Offset from the platform's standard ports (60021 / 4200 / 8000 / 27017 / 6060) so this dev-kit can run
# ALONGSIDE a local DuploCloud platform dev stack without clashing. Change any of these if they still collide
# with something on your machine.
STUDIO_PORT=60031
UI_PORT=4210
AGENT_PORT=8010
MONGO_PORT=27018
XTERM_PORT=6061

# ── Target for /duplo-extension + scripts/ ──
# 'local'  → the dev-kit stack on localhost:STUDIO_PORT, authed with DUPLO_ADMIN_TOKEN (set by run.sh).
# 'remote' → an existing DuploCloud platform: set DUPLO_HOST + DUPLO_TOKEN (an Administrator bearer token).
DUPLO_TARGET=local
DUPLO_HOST=
DUPLO_TOKEN=
# Remote only: the workspace to author against. If blank, /duplo-extension lists the remote's workspaces and asks.
DUPLO_WORKSPACE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is MANAGED BY ./run.sh — leave blank; run.sh prompts/fills them.
# Re-running ./run.sh is idempotent; `./run.sh --reset` wipes the DB and these values (except the two
# licensing keys, which only `./run.sh --reset-license` clears).
# ─────────────────────────────────────────────────────────────────────────────
# Login (run.sh prompts). LocalAdminEmail must be in SuperUsers to get the Administrator role.
Authentication__LocalAdminEmail=
Authentication__LocalAdminPassword=
Authentication__SuperUsers=
Authentication__FrontendBaseUrl=
# Stable secrets (run.sh generates once; regenerated only on --reset).
Authentication__JwtSharedSecret=
Encryption__MasterKey=

# License JWT (run.sh fetches it on first run; the studio reads it as Licensing:Token).
# The license server issues ONE license per email address. If this is ever wiped, run.sh recovers the same
# license rather than requesting a second one: it asks the server to email you a confirmation link and picks
# the license up when you click it. --reset leaves this alone — a license isn't stack state — and only
# --reset-license clears it. Blanking just this line is safe: the next run re-fetches the same license,
# straight from one of the ids below if either is set.
Licensing__Token=
# The id of the license request run.sh made for your admin email. The license server verifies the address
# by email before it issues anything, so run.sh polls this id for the license — and keeps it afterwards as
# the handle for pulling that same license back down, rather than requesting a second one the server would
# refuse. Cleared only by --reset-license, which is what makes that flag irreversible.
LICENSE_TRIAL_UUID=
# Set when your address already had a license and run.sh recovered it: the id of that recovery request. The
# server emails you a confirmation link, and this is the handle run.sh polls for the result — including on a
# later run, so a link you click after the script stops waiting still lands. Cleared only by --reset-license.
LICENSE_RECOVERY_UUID=
# The address the two ids above were requested for. Either id can only ever verify that one address, so
# run.sh checks this before polling: enter a different admin email — say you mistyped the first one and never
# got the mail — and the ids are dropped and a fresh request goes to the address you actually gave. Written
# with the ids, cleared with them.
LICENSE_REQUEST_EMAIL=
# Required for standalone (no DuploCloud master) operation.
AIStudio__IsMasterDisabled=true
# Dev-kit only: exposes the per-extension "Clean Database" admin action (drops one extension's data collections).
AIStudio__DevKitMode=true

# LLM provider for the agent (run.sh sets these from your --model choice).
#   anthropic              → ANTHROPIC_API_KEY + CLAUDE_MODEL=claude-sonnet-4-6
#   bedrock                → AWS_* + CLAUDE_MODEL=us.anthropic.claude-sonnet-4-6
#   gateway                → ANTHROPIC_BASE_URL (+ ANTHROPIC_AUTH_TOKEN if the gateway needs one) +
#                            CLAUDE_MODEL named the way the gateway lists it. Any Anthropic-compatible
#                            endpoint: OpenRouter, Bifrost, LiteLLM, Snowflake Cortex. The agent takes this
#                            path only when ANTHROPIC_API_KEY is EMPTY (key + URL means "proxy in front of
#                            the real Anthropic API"), so run.sh blanks the key when you pick gateway.
#   subscription           → CLAUDE_CODE_OAUTH_TOKEN + a bare CLAUDE_MODEL (claude-sonnet-4-6). Runs the
#                            agent on YOUR Claude Code subscription, minted on your machine with
#                            `claude setup-token`. Usage counts against your own Claude Code limits and
#                            the token authenticates as you, so this is a local-development choice, not
#                            something to put in a shared stack. Sits next-to-last in the agent's
#                            precedence chain, so run.sh blanks ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL
#                            when you pick it — otherwise either would win and the token never be read.
#                            Ticket titles are not generated on this path (the title LLM is Bedrock-only).
#   bedrock-instance-role  → AWS_REGION only; the agent's credential chain falls through to the EC2
#                            instance role via IMDS, so no keys are stored here. Offered by run.sh
#                            only when scripts/detect-bedrock.sh proves the role can invoke the model
#                            AND containers can reach IMDS (needs an IMDSv2 hop limit of 2).
DEVKIT_MODEL=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
# subscription only — a long-lived token from `claude setup-token` (sk-ant-oat01-…), NOT the
# short-lived credential in your OS keychain and NOT an sk-ant-api… API key.
CLAUDE_CODE_OAUTH_TOKEN=
# gateway only. The CLAUDE_CODE_* knobs are forwarded to the agent only when set:
#   CLAUDE_CODE_MAX_CONTEXT_TOKENS            run.sh sets 262144 when you pick gateway. A gateway usually
#                                             serves model ids the Claude CLI doesn't recognise, and an
#                                             unrecognised id has no known context window — long sessions
#                                             then fail with a 400 instead of compacting. Override with
#                                             --gateway-max-context-tokens, or edit here (re-runs keep it).
#   CLAUDE_CODE_AUTO_COMPACT_WINDOW           run.sh sets 200000 when you pick gateway: the threshold at
#                                             which a session compacts. Keep it below MAX_CONTEXT_TOKENS.
#   CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1  not set by default. Required for Snowflake Cortex (rejects
#                                             Claude Code's beta headers with "400 invalid beta flag");
#                                             OpenRouter/Bifrost/LiteLLM strip them themselves.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=
CLAUDE_CODE_MAX_CONTEXT_TOKENS=
CLAUDE_CODE_AUTO_COMPACT_WINDOW=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# (Azure AI Foundry also works if you set these instead.)
AZURE_BASE_URL=
AZURE_API_KEY=
AZURE_CLIENT_ID=

# Created by run.sh: a never-expiring admin API token, the auto-created extension-dev workspace id, and
# the permission set + group that grant the admin user UI access to that workspace.
DUPLO_ADMIN_TOKEN=
EXTENSION_DEV_WORKSPACE_ID=
EXTENSION_DEV_PERMSET_ID=
EXTENSION_DEV_PERMSETGROUP_ID=

# Usage metrics. run.sh prompts on first run; the default is opted in. 1 = on, 0 = off.
# To change afterwards: set DUPLO_USAGE_METRICS to 0 or 1 and re-run ./run.sh — it re-derives
# METRICS_CONF, which picks the nginx fragment that adds or strips the UI's Mixpanel key.
# See PRIVACY.md. Both MUST ship blank so a first run actually prompts.
#
#   DUPLO_USAGE_METRICS=1  (opted IN)   → METRICS_CONF=metrics-on.conf   → key present in the UI
#   DUPLO_USAGE_METRICS=0  (opted OUT)  → METRICS_CONF=metrics-off.conf  → key stripped from the UI
DUPLO_USAGE_METRICS=
# Derived by run.sh from DUPLO_USAGE_METRICS — do not hand-edit; changing this alone does nothing.
METRICS_CONF=
